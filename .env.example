# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# GAPGPT API Configuration (Unified Gateway for Text & High-End Image Creation with 1 Key)
# Base URL defaults to https://api.gapgpt.com/v1 if left empty.
GAPGPT_API_KEY=""
GAPGPT_BASE_URL="https://api.gapgpt.com/v1"
GAPGPT_MODEL="gapgpt-qwen-3.8"
GAPGPT_IMAGE_FAST_MODEL="gapgpt/z-image"
GAPGPT_IMAGE_QUALITY_MODEL="gpt-image-2"

# OPENROUTER & GROQ (Alternative Cloud Providers)
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# VISUAL STUDIO & IMAGE GENERATION (Optional)
FAL_KEY=""
CLOUDINARY_URL=""

# LOCAL AI ENGINE CONFIGURATION (macOS MLX / Windows Ollama)
# Options: "gemini" | "gapgpt" | "mlx" | "ollama" | "auto"
ACTIVE_ENGINE="auto"
MLX_SERVER_URL="http://localhost:8080/v1"
OLLAMA_SERVER_URL="http://localhost:11434/v1"
OLLAMA_MODEL_NAME="llama3.1:8b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

